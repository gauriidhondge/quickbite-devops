{
  "name": "quickbite",
  "version": "1.0.0",
  "description": "QuickBite - Campus Canteen Pre-Order Service (DevOps FA2)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage --runInBand",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "express": "^4.21.2",
    "prom-client": "^15.1.3",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
